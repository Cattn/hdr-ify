{
	"name": "@cattn/hdr",
	"version": "0.4.0",
	"description": "Render color in HDR — Svelte components/attachments and framework-agnostic web components",
	"license": "MIT",
	"author": "cattn",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cattn/hdr-ify.git"
	},
	"homepage": "https://github.com/cattn/hdr-ify#readme",
	"bugs": {
		"url": "https://github.com/cattn/hdr-ify/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"package": "svelte-kit sync && svelte-package && npm run build:elements && publint",
		"build:elements": "vite build --config vite.elements.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/elements/**"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		},
		"./elements": {
			"types": "./dist/elements/index.d.ts",
			"default": "./dist/elements/hdr-elements.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.1",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"keywords": [
		"svelte",
		"hdr",
		"web-components",
		"custom-elements",
		"display-p3"
	],
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261119.1": true
	}
}
